{
  "name": "evently",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11.6.4 <12"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @evently/web",
    "dev:api": "npm run dev --workspace @evently/api",
    "typecheck": "npm run build --workspace @evently/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages eslint.config.js vitest.config.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,html,css}\" \"packages/**/*.{ts,tsx,json}\" \"docs/**/*.md\" \"README.md\" \"*.{json,js}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,html,css}\" \"packages/**/*.{ts,tsx,json}\" \"docs/**/*.md\" \"README.md\" \"*.{json,js}\" \".github/workflows/*.yml\"",
    "test": "npm run build --workspace @evently/shared && vitest run",
    "build": "npm run build --workspace @evently/shared && npm run build --workspace @evently/api && npm run build --workspace @evently/web",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
